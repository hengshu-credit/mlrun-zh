{
  "project": "transaction-feature-demo",
  "description": "Transaction logs: user/order aggregates, point-in-time training and HTTP serving",
  "feature_set": "transaction-features",
  "training_vector": "transaction-training",
  "serving_vector": "transaction-serving",
  "training_function": "train-orders",
  "model_function": "model-service",
  "feature_function": "feature-service",
  "model_name": "order-classifier",
  "image": "mlrun/mlrun:1.13.0-rc7",
  "redis_url": "redis://mlrun-feature-redis.mlrun.svc.cluster.local:6379",
  "random_state": 42,
  "n_estimators": 100,
  "test_size": 0.2,
  "database_host": "mlrun-timescaledb.mlrun.svc.cluster.local",
  "database_port": 5432,
  "database_name": "mlrun",
  "database_user": "postgres",
  "database_schema": "transaction_feature_demo",
  "visibility": "as_known",
  "features": [
    {"name": "user_payment_count_1h", "entity": "user_id", "operation": "count", "event_type": "payment", "window_seconds": 3600},
    {"name": "user_payment_sum_24h", "entity": "user_id", "operation": "sum", "event_type": "payment", "window_seconds": 86400},
    {"name": "user_payment_avg_7d", "entity": "user_id", "operation": "avg", "event_type": "payment", "window_seconds": 604800},
    {"name": "user_failed_count_24h", "entity": "user_id", "operation": "count", "event_type": "payment_failed", "window_seconds": 86400},
    {"name": "user_refund_sum_7d", "entity": "user_id", "operation": "sum", "event_type": "refund", "window_seconds": 604800},
    {"name": "order_item_count_24h", "entity": "order_id", "operation": "count", "event_type": "item", "window_seconds": 86400},
    {"name": "order_item_sum_24h", "entity": "order_id", "operation": "sum", "event_type": "item", "window_seconds": 86400},
    {"name": "order_failed_count_24h", "entity": "order_id", "operation": "count", "event_type": "payment_failed", "window_seconds": 86400}
  ],
  "model_local_port": 18081,
  "feature_local_port": 18082
}
